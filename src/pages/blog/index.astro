---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Blog" description="Psikoloji, ruh sağlığı ve kişisel gelişim üzerine yazılar.">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary to-primary/90 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-serif text-4xl md:text-5xl font-bold mb-6">Blog</h1>
      <p class="font-sans text-lg text-white/90 max-w-2xl mx-auto">
        Psikoloji, ruh sağlığı ve kişisel gelişim üzerine güncel yazılar.
      </p>
    </div>
  </section>

  <!-- Blog Listesi -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      {posts.length === 0 ? (
        <p class="font-sans text-gray-600 text-center">Yakında yeni yazılar burada olacak.</p>
      ) : (
        <div class="divide-y divide-gray-200 border-t border-gray-200">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="group flex items-center gap-6 py-8" data-reveal>
              <div class="w-28 h-28 md:w-36 md:h-36 flex-shrink-0 rounded-xl overflow-hidden bg-gradient-to-br from-primary/15 to-accent/15 flex items-center justify-center">
                <span class="font-serif text-3xl text-primary/40">📝</span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-3 mb-2">
                  <span class="inline-block bg-primary/10 text-primary text-xs font-sans font-semibold uppercase tracking-wide px-3 py-1 rounded-full">{post.data.category}</span>
                  <time datetime={post.data.date.toISOString()} class="font-sans text-xs text-gray-500">
                    {post.data.date.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </div>
                <h2 class="font-serif text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">{post.data.title}</h2>
              </div>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
