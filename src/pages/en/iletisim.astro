---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MapPin, Mail, Phone, MessageCircle, Clock } from '@lucide/astro';
import { CONTACT } from '../../lib/site-config';
---

<BaseLayout title="Contact" description="Get in touch with Büşra Uğurcan Hanözü — WhatsApp, email, or the contact form.">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary to-primary/90 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-serif text-4xl md:text-5xl font-bold mb-6">Contact</h1>
      <p class="font-sans text-lg text-white/90 max-w-2xl mx-auto">
        You don't have to carry this by yourself. A short message is enough for the first step.
      </p>
    </div>
  </section>

  <!-- Form & info -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Form -->
        <div data-reveal>
          <h2 class="font-serif text-2xl font-bold text-primary mb-6">Send Me a Message</h2>
          <form name="contact-en" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-6">
            <input type="hidden" name="form-name" value="contact-en" />
            <p class="hidden">
              <label>
                Don't fill this out: <input name="bot-field" />
              </label>
            </p>

            <div>
              <label for="name" class="block font-sans text-sm font-medium text-gray-700 mb-2">Full Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-colors font-sans"
                placeholder="Your name"
              />
            </div>

            <div>
              <label for="email" class="block font-sans text-sm font-medium text-gray-700 mb-2">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-colors font-sans"
                placeholder="you@example.com"
              />
            </div>

            <div>
              <label for="message" class="block font-sans text-sm font-medium text-gray-700 mb-2">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-colors font-sans resize-none"
                placeholder="Write your message here..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="bg-primary hover:bg-primary/90 text-white font-sans font-semibold px-8 py-3 rounded-sm transition-colors"
            >
              Send
            </button>
          </form>
        </div>

        <!-- Contact info -->
        <div data-reveal>
          <h2 class="font-serif text-2xl font-bold text-primary mb-6">Contact Details</h2>
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 bg-primary/10 rounded-sm flex items-center justify-center flex-shrink-0">
                <MapPin class="w-5 h-5 text-primary" />
              </div>
              <div>
                <h3 class="font-sans font-semibold text-gray-800">Location</h3>
                <p class="font-sans text-sm text-gray-600">{CONTACT.location.en}</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 bg-primary/10 rounded-sm flex items-center justify-center flex-shrink-0">
                <Mail class="w-5 h-5 text-primary" />
              </div>
              <div>
                <h3 class="font-sans font-semibold text-gray-800">Email</h3>
                <a href={`mailto:${CONTACT.email}`} class="font-sans text-sm text-gray-600 hover:text-primary transition-colors">{CONTACT.email}</a>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 bg-primary/10 rounded-sm flex items-center justify-center flex-shrink-0">
                <Phone class="w-5 h-5 text-primary" />
              </div>
              <div>
                <h3 class="font-sans font-semibold text-gray-800">Phone</h3>
                <a href={CONTACT.phoneHref} class="font-sans text-sm text-gray-600 hover:text-primary transition-colors">{CONTACT.phoneDisplay}</a>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 bg-primary/10 rounded-sm flex items-center justify-center flex-shrink-0">
                <MessageCircle class="w-5 h-5 text-primary" />
              </div>
              <div>
                <h3 class="font-sans font-semibold text-gray-800">WhatsApp</h3>
                <a href={CONTACT.whatsappUrl} target="_blank" rel="noopener" class="font-sans text-sm text-gray-600 hover:text-primary transition-colors">{CONTACT.phoneDisplay}</a>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-10 h-10 bg-primary/10 rounded-sm flex items-center justify-center flex-shrink-0">
                <Clock class="w-5 h-5 text-primary" />
              </div>
              <div>
                <h3 class="font-sans font-semibold text-gray-800">Office Hours</h3>
                <p class="font-sans text-sm text-gray-600">Every day: 09:00 - 18:00</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
