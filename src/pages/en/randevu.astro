---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CALENDLY_URL, CONTACT } from '../../lib/site-config';
---

<BaseLayout title="Book a Session" description="Book a session with Büşra Uğurcan Hanözü.">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary to-primary/90 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-serif text-4xl md:text-5xl font-bold mb-6">Book a Session</h1>
      <p class="font-sans text-lg text-white/90 max-w-2xl mx-auto">
        Choose a time that works for you.
      </p>
    </div>
  </section>

  <!-- Calendly embed -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-secondary rounded-xl p-8" data-reveal>
        <h2 class="font-serif text-2xl font-bold text-primary mb-6 text-center">Pick a Time</h2>
        <div class="calendly-inline-widget" data-url={CALENDLY_URL} style="min-width:320px;height:700px;"></div>
        <p class="font-sans text-sm text-gray-600 text-center mt-6">
          If none of these times work, feel free to message me directly on <a href={CONTACT.whatsappUrl} target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">WhatsApp</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
