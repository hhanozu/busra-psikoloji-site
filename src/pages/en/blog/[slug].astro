---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
  <article class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="font-sans text-xs text-gray-500 mb-6">This post is currently available in Turkish only.</p>
      <div class="mb-8">
        <span class="inline-block bg-primary/10 text-primary text-xs font-sans font-semibold px-3 py-1 rounded-full mb-4">{post.data.category}</span>
        <h1 class="font-serif text-3xl md:text-4xl font-bold text-gray-800 mb-4">
          {post.data.title}
        </h1>
        <div class="flex items-center text-sm text-gray-500 font-sans">
          <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB')}</time>
        </div>
      </div>

      <div class="prose prose-lg max-w-none font-sans text-gray-700 leading-relaxed">
        <Content />
      </div>

      <div class="mt-12 pt-8 border-t border-gray-200">
        <a href="/en/blog" class="inline-flex items-center text-primary font-sans font-semibold hover:text-primary/80 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to All Posts
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
