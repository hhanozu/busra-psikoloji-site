---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import { getCollection } from 'astro:content';
import { INSTAGRAM_URL, HAS_PROFESSIONAL_PHOTO } from '../lib/site-config';
import { Globe, Moon, Heart, Sparkles } from '@lucide/astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const reels = [
  { tag: 'Göç Psikolojisi', name: 'İki eve de ait olamamak' },
  { tag: 'Yalnızlık & Aidiyet', name: 'Kalabalıkta yalnızlık' },
  { tag: 'Kaygı', name: 'Kaygı geldiğinde topraklan' },
  { tag: 'Çift & İlişki', name: 'Kavga değil, karşılanmamış ihtiyaç' },
  { tag: 'Göç Psikolojisi', name: 'Gurbetin adı konmamış yası' },
  { tag: 'Kaygı', name: 'Nefes, sinir sistemini yavaşlatır' },
];

const specialties = [
  { icon: Globe, title: 'Göç Psikolojisi & Kültürel Uyum', description: 'Kültür şoku, aidiyet krizi, kimlik, iki eve de ait olamamak, akülturasyon stresi.' },
  { icon: Moon, title: 'Kaygı & Depresyon', description: 'Belirtileri tanımak, kanıta dayalı baş etme becerileri, CBT ve EMDR ile yapılandırılmış çalışma.' },
  { icon: Heart, title: 'Çift & İlişki', description: 'Uzak mesafe, kültürlerarası çift dinamikleri, gurbette evlilik, iletişim örüntüleri.' },
  { icon: Sparkles, title: 'Çocuk & Ergen', description: 'Çocuk merkezli oyun terapisi, okul uyumu, sınav kaygısı, duygu düzenleme becerileri.' },
];

const stats = [
  { number: '10+', label: 'Yıl Klinik Deneyim' },
  { number: '4', label: 'Uzmanlık Alanı' },
  { number: '2', label: 'Dilde Terapi' },
];
---

<BaseLayout title="Ana Sayfa" description="Uzm. Kl. Psk. Büşra Uğurcan Hanözü — Kuveyt ve İstanbul'da Türkçe ve İngilizce online & yüz yüze terapi.">
  <!-- Hero Bölümü -->
  <section class="relative bg-secondary overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div data-reveal>
        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-primary"></span>
          <span class="font-sans text-xs font-bold uppercase tracking-widest text-gray-500">Uzm. Kl. Psikolog</span>
        </div>
        <h1 class="font-serif text-4xl md:text-5xl font-normal leading-tight text-gray-900 mb-6 italic">
          Ne buraya tam ait hissediyorsun,<br class="hidden md:block" /> ne de geride bıraktığın yere…
          <span class="block not-italic text-primary mt-3 text-2xl md:text-3xl">Bu duygunun bir adı var.</span>
        </h1>
        <p class="font-sans text-lg text-gray-600 leading-relaxed max-w-md mb-10">
          Yurtdışında yaşayan Türkler, Kuveyt'teki Türk topluluğu ve İngilizce konuşan danışanlar için
          online ve yüz yüze terapi. Bilimsel, yargılamayan, sıcak bir alan.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/randevu" class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-soft text-white font-sans font-medium text-sm tracking-wide px-8 py-4 rounded-sm transition-colors">
            Randevu Alın
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href="/hakkimda" class="inline-flex items-center justify-center gap-2 border border-gray-900/20 hover:border-primary hover:text-primary text-gray-900 font-sans font-medium text-sm tracking-wide px-8 py-4 rounded-sm transition-colors">
            Daha Fazla Bilgi
          </a>
        </div>
      </div>

      <div class="relative flex justify-center lg:justify-end" data-reveal>
        <div class="absolute -top-4 right-2 w-56 h-56 md:w-72 md:h-72 rounded-full bg-sage-light/25 animate-float-slow" aria-hidden="true"></div>
        <div class="absolute bottom-2 left-4 w-16 h-16 rounded-full border border-primary/20 animate-float-slower" aria-hidden="true"></div>

        <div class="relative z-10">
          <PhotoPlaceholder alt="Büşra Uğurcan Hanözü" class="w-64 h-80 md:w-80 md:h-[26rem] rounded-sm object-cover" />
          <div class="absolute -bottom-4 -left-8 bg-white shadow-lg pl-5 pr-6 py-4 border-l-2 border-primary">
            <p class="font-serif text-3xl text-gray-900 leading-none">10+</p>
            <p class="font-sans text-[0.65rem] uppercase tracking-widest text-gray-500 mt-1">Yıl Deneyim</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- İstatistikler -->
  <div class="bg-warm-beige border-y border-gray-900/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid grid-cols-3">
      {stats.map((stat, i) => (
        <div class:list={["text-center px-4", { "border-r border-gray-900/10": i < stats.length - 1 }]}>
          <p class="font-serif text-3xl md:text-4xl text-gray-900">{stat.number}</p>
          <p class="font-sans text-[0.65rem] uppercase tracking-widest text-gray-500 mt-2">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Hakkımda Özeti -->
  <section class="py-24 md:py-32 bg-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="relative flex justify-center" data-reveal>
          <div class="absolute inset-0 max-w-sm mx-auto rounded-full" style="background: radial-gradient(circle, rgba(163,196,168,0.22) 0%, transparent 70%)" aria-hidden="true"></div>
          <PhotoPlaceholder alt="Büşra Uğurcan Hanözü" class="relative z-10 w-64 h-64 md:w-80 md:h-80 rounded-full object-cover ring-8 ring-sage-light/15" />
        </div>
        <div data-reveal>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-px bg-primary"></span>
            <span class="font-sans text-xs font-bold uppercase tracking-widest text-gray-500">Hakkımda</span>
          </div>
          <blockquote class="font-serif italic text-xl md:text-2xl text-gray-900 leading-snug border-l-2 border-primary pl-5 mb-6">
            "İyileşme, kendinize gösterdiğiniz şefkatle başlar."
          </blockquote>
          <p class="font-sans text-gray-600 leading-relaxed mb-4">
            Klinik psikoloğum. 2018'den bu yana Kuveyt ve İstanbul'da özel pratiğimde çocuk, ergen ve yetişkinlerle
            çalışıyorum. Her danışanımın benzersiz hikayesine saygı duyarak güvenli bir alan sunuyorum.
          </p>
          <p class="font-sans text-gray-600 leading-relaxed mb-8">
            Göç psikolojisi, kaygı bozuklukları, depresyon ve ilişki sorunları alanlarında uzmanlaşmış olup,
            online ve yüz yüze danışmanlık hizmeti vermekteyim.
          </p>
          <a href="/hakkimda" class="inline-flex items-center gap-2 text-primary font-sans font-medium text-sm border-b border-primary/30 hover:border-primary pb-0.5 transition-colors">
            Hikayemin Tamamını Okuyun
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Ambiyans Videosu -->
  <section class="relative h-[60vh] min-h-[380px] overflow-hidden">
    <video
      class="absolute inset-0 w-full h-full object-cover"
      poster="/images/calm-ocean-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="none"
    >
      <source src="/videos/calm-ocean.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-ink/55"></div>
    <div class="relative z-10 h-full flex items-center justify-center text-center px-6" data-reveal>
      <p class="font-serif italic text-2xl md:text-4xl text-white max-w-2xl leading-snug">
        Sakinlik, bir varış noktası değil — birlikte inşa ettiğimiz bir alışkanlıktır.
      </p>
    </div>
  </section>

  <!-- Uzmanlık Alanları (koyu) -->
  <section class="py-24 md:py-32 bg-ink">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-4" data-reveal>
        <span class="w-8 h-px bg-primary"></span>
        <span class="font-sans text-xs font-bold uppercase tracking-widest text-white/50">Hizmetler</span>
      </div>
      <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-6 mb-16" data-reveal>
        <h2 class="font-serif text-3xl md:text-5xl text-white leading-tight">
          Nasıl Destek<br /><span class="text-sage-light">Olabilirim</span>
        </h2>
        <a href="/hizmetler" class="inline-flex items-center gap-2 text-sage-light font-sans font-medium text-sm border-b border-sage-light/30 hover:border-sage-light pb-0.5 transition-colors">
          Tüm Hizmetleri Gör
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-ink-soft">
        {specialties.map((s, i) => (
          <div class="bg-ink hover:bg-ink-soft p-10 transition-colors group" data-reveal>
            <div class="flex justify-between items-start mb-8">
              <s.icon class="w-6 h-6 text-sage-light" />
              <span class="font-serif text-4xl text-white/5 leading-none">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="font-serif text-xl text-white mb-3">{s.title}</h3>
            <p class="font-sans text-sm text-white/50 leading-relaxed">{s.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Süreç -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12" data-reveal>
        <h2 class="font-serif text-3xl md:text-4xl text-gray-900 mb-4">İlk Adım Çoğu Zaman En Zoru</h2>
        <p class="font-sans text-gray-600 max-w-2xl mx-auto">Kolaylaştıralım.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center" data-reveal>
          <div class="font-serif text-4xl text-primary mb-3">1</div>
          <h3 class="font-serif text-lg text-gray-900 mb-2">Yazın</h3>
          <p class="font-sans text-sm text-gray-600">WhatsApp ya da e-posta ile kısaca kendinizden bahsedin.</p>
        </div>
        <div class="text-center" data-reveal>
          <div class="font-serif text-4xl text-primary mb-3">2</div>
          <h3 class="font-serif text-lg text-gray-900 mb-2">Tanışalım</h3>
          <p class="font-sans text-sm text-gray-600">Kısa bir ön görüşmede ihtiyacınızı birlikte netleştirelim.</p>
        </div>
        <div class="text-center" data-reveal>
          <div class="font-serif text-4xl text-primary mb-3">3</div>
          <h3 class="font-serif text-lg text-gray-900 mb-2">Birlikte Çalışalım</h3>
          <p class="font-sans text-sm text-gray-600">Düzenli seanslarla, kanıta dayalı yöntemlerle ilerleyelim.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Instagram / Reels Vitrini -->
  <section class="py-24 bg-warm-beige">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12" data-reveal>
        <h2 class="font-serif text-3xl md:text-4xl text-gray-900 mb-4">Instagram'da: Kısa Videolarla Ruh Sağlığı</h2>
        <p class="font-sans text-gray-600 max-w-2xl mx-auto">
          Her hafta Türkçe ve İngilizce kısa videolar paylaşıyorum — göç, aidiyet, kaygı ve ilişkiler üzerine.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {reels.map((reel) => (
          <div class="bg-white rounded-sm p-5" data-reveal>
            <span class="block font-sans text-xs font-bold uppercase tracking-wider text-accent mb-1">{reel.tag}</span>
            <span class="font-serif text-lg text-gray-900">{reel.name}</span>
          </div>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="inline-block bg-primary hover:bg-primary-soft text-white font-sans font-medium text-sm px-8 py-4 rounded-sm transition-colors">
          Instagram'da Takip Edin
        </a>
      </div>
    </div>
  </section>

  <!-- Duygu Dedektifleri -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-secondary rounded-sm p-10 md:p-14 grid grid-cols-1 md:grid-cols-[1.2fr_0.8fr] gap-10 items-center" data-reveal>
        <div>
          <span class="inline-block bg-accent text-white text-xs font-bold uppercase tracking-wider rounded-sm px-4 py-1 mb-4">Yakında</span>
          <h2 class="font-serif text-3xl text-gray-900 mb-4">Duygu Dedektifleri — Çocuklar İçin Duygu Eğitimi</h2>
          <p class="font-sans text-gray-600 leading-relaxed">
            4–6 yaş çocuklar için, sosyal-duygusal gelişim (SEL) temelli Türkçe animasyon bölümleri hazırlıyorum.
            Her bölüm tek bir duyguya odaklanıyor; çocuklara duygularını tanımayı ve düzenlemeyi küçük, akılda
            kalıcı stratejilerle öğretiyor.
          </p>
        </div>
        <div class="aspect-square rounded-sm bg-primary/10 flex items-center justify-center">
          <span class="font-serif text-xl text-primary text-center px-4">Duygu<br />Dedektifleri</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Önizleme (editoryal stil) -->
  <section class="py-24 bg-secondary">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-12" data-reveal>
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-px bg-gray-400"></span>
            <span class="font-sans text-xs font-bold uppercase tracking-widest text-gray-500">Son Yazılar</span>
          </div>
          <h2 class="font-serif text-4xl md:text-5xl leading-tight">
            <span class="text-gray-900">Yazılar ve</span> <span class="text-primary">Düşünceler</span>
          </h2>
        </div>
        <a href="/blog" class="inline-flex items-center gap-2 font-sans text-sm font-medium text-primary hover:text-primary-soft transition-colors">
          Tüm Yazıları Gör
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="divide-y divide-gray-900/10 border-t border-gray-900/10">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="group flex items-center gap-6 py-8" data-reveal>
            <div class="w-28 h-28 md:w-36 md:h-36 flex-shrink-0 rounded-sm overflow-hidden bg-gradient-to-br from-primary/15 to-accent/15 flex items-center justify-center">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <span class="font-serif text-3xl text-primary/40">📝</span>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 mb-2">
                <span class="inline-block bg-sage-muted text-primary text-xs font-sans font-semibold uppercase tracking-wide px-3 py-1 rounded-sm">{post.data.category}</span>
                <time datetime={post.data.date.toISOString()} class="font-sans text-xs text-gray-500">
                  {post.data.date.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
              <h3 class="font-serif text-xl text-gray-900 mb-1 group-hover:text-primary transition-colors">{post.data.title}</h3>
            </div>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary text-white py-24 md:py-32">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-reveal>
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-white/60 mb-6">İlk Adımı Atın</p>
      <h2 class="font-serif text-3xl md:text-5xl leading-tight mb-6">
        Yolculuğunuza Başlamaya<br />Hazır mısınız?
      </h2>
      <p class="font-sans text-white/80 leading-relaxed max-w-xl mx-auto mb-10">
        İlk seans, hikayenizi paylaşmanız ve birlikte doğru uyumu keşfetmemiz için bir fırsat — baskı ya da yükümlülük olmadan.
      </p>
      <a href="/randevu" class="inline-flex items-center gap-2 bg-white text-primary font-sans font-medium text-sm px-8 py-4 rounded-sm hover:bg-secondary transition-colors">
        İlk Seansınızı Ayırtın
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
