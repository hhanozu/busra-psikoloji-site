---
import { HAS_PROFESSIONAL_PHOTO } from '../lib/site-config';

export interface Props {
  alt: string;
  labelTr?: string;
  labelEn?: string;
  class?: string;
}

const {
  alt,
  labelTr = 'Fotoğraf eklenecek',
  labelEn = 'Photo coming soon',
  class: className = '',
} = Astro.props;
---

{HAS_PROFESSIONAL_PHOTO ? (
  <img
    src="/images/busra-photo.jpg"
    alt={alt}
    class={`block ${className}`}
  />
) : (
  <div class={`flex flex-col items-center justify-center gap-3 border-2 border-dashed border-primary/30 bg-primary/5 p-8 text-center ${className}`}>
    <svg class="w-10 h-10 text-primary/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
    <p class="font-sans text-sm text-primary/70">
      <span class="block">{labelTr}</span>
      <span class="block text-xs italic">{labelEn}</span>
    </p>
  </div>
)}
