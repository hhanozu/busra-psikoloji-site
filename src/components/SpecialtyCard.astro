---
export interface Props {
  icon: 'globe' | 'moon' | 'heart' | 'sparkles';
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;

import { Globe, Moon, Heart, Sparkles } from '@lucide/astro';

const icons = { globe: Globe, moon: Moon, heart: Heart, sparkles: Sparkles };
const Icon = icons[icon];
---

<div class="bg-white rounded-sm p-6 shadow-sm hover:shadow-md transition-shadow" data-reveal>
  <div class="w-12 h-12 bg-primary/10 rounded-sm flex items-center justify-center mb-4">
    <Icon class="w-6 h-6 text-primary" />
  </div>
  <h3 class="font-serif text-xl font-bold text-primary mb-2">{title}</h3>
  <p class="font-sans text-sm text-gray-600 leading-relaxed">{description}</p>
</div>
