---
export interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<details class="group border-b border-gray-200 py-5" data-reveal>
  <summary class="flex items-center justify-between cursor-pointer font-sans font-semibold text-gray-800 list-none">
    {question}
    <span class="font-serif text-2xl text-accent ml-4 group-open:hidden">+</span>
    <span class="font-serif text-2xl text-accent ml-4 hidden group-open:inline">–</span>
  </summary>
  <p class="font-sans text-sm text-gray-600 leading-relaxed mt-3 max-w-2xl">{answer}</p>
</details>
